
@{
    ViewBag.Title = "MVC02 Html Helpers";

}

<h2>MVC02 Html Helpers</h2>

@Html.ActionLink("Anasayfa", "Index", "Home")

@Html.ActionLink("MVC Razor Syntax", "Index", "MVCRazorSyntax")

<a href="/Home">Anasayfa</a>

<a href="/Home/Index">Anasayfa</a>

<hr />

<h3>
    Html Checkbox Oluşturma
</h3>

<label>
    <input type="checkbox" name="cbOnay" /> Onaylıyorum
</label>

<br />

<label>
    @Html.CheckBox("Onay") Onaylıyorum
</label>

<h3>
    Html TextBox Oluşturma
</h3>

<input type="text" name="txtAd" value="" />

<br />

@Html.TextBox("txtSoyad")

<h3>
    Html Editor
</h3>

<input type="number" name="txtMiktar" value="" />

<br />

<h3>Html Hidden(Gizli Element) Oluşturma</h3>

@Html.Hidden("GizliElement", "Html Hidden(Gizli Element) deki veriler saece sayfa kaynağında görünür")

Html Hidden(Gizli Element) deki veriler sadece sayfa kaynağında görünür

<hr />

<h3>Html Label Oluşturma</h3>

@Html.Label("lblAd", "Html label elementi")

<hr />

<h3>
    Html Textarea(Çok satırlı input) Oluşturma
</h3>

@Html.TextArea("txtAdres", "Html TextArea(Çok satırlı input) Oluşturma")

<hr />

<h3>Html Password (Şifre alanı) Oluşturma</h3>

@Html.Password("txtPassword")

<hr />

<h3>Html Helpers ile Form Oluşturma</h3>

@using (Html.BeginForm())
{
    <h3>Kullanıcı Adı</h3>
    @Html.Editor("txtKullaniciAdi")
    <h3>Şifre</h3>
    @Html.Password("txtPassword")
    <br />
    <input type="submit" value="Giriş" />
}
<hr />

<h3>Listbox ve DropDownList Elementi Kullanımı</h3>

@{
    var liste = new SelectListItem[]
            {
        new SelectListItem() {Text = "Bilgisayar"},
        new SelectListItem() {Text = "Elektronik"},
        new SelectListItem() {Text = "Telefon"}
            };
}

@Html.ListBox("lbListe", liste)
<br />
@Html.DropDownList("ddListe", liste)

<hr />

<h3>RadioButton Elementi Kullanımı</h3>

<h5>Sözleşmeyi</h5>

<label>
    @Html.RadioButton("rbOnay", "Onay") Onaylıyorum
</label>

<label>
    @Html.RadioButton("rbOnay", "Red") Onaylamıyorum
</label>

<hr />

<h3>Html Raw ile Ekrana Html İçerik Yazdırma</h3>

@{
    string htmlRawOrnek = "<h3> Html Raw ile Ekrana Html İçerik Yazdırma </h3>";
}

@htmlRawOrnek

@Html.Raw(htmlRawOrnek)

@Html.Raw("<b style='color:red'>Html Raw ile Ekrana Html İçerik Yazdırma </b>" )

<hr />


<h2>Tag Helpers</h2>

<h3>
    a Elementi
</h3>

<a asp-action="Index" asp-controller="Home" asp-route-id="18">Anasayfa</a>

<h3>
    Form Oluşturma
</h3>

<form asp-action="Index" asp-controller="MVC02HtmlHelpers" method="post">
    <h4>Kullanıcı Adı</h4>
    <input id="txtKullaniciAdi" type="text" name="txtKullaniciAdi" value="" />
    <h4>Şifre</h4>
    <input id="txtSifre" name="txtSifre" type="text" value="" />
    <br />
    <input type="submit" value="Giriş" />
</form>